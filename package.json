{
  "name": "nightmare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm --prefix api run dev",
    "dev:all": "concurrently -n web,api -c cyan,blue \"npm run dev\" \"npm run dev:api\"",
    "calculator:audit": "node scripts/audit-calculator-core.mjs",
    "calculator:audit:parser": "tsx scripts/audit-calculator-parser-coverage.ts",
    "data:skill-tooltips": "tsx scripts/generate-skill-tooltips.ts",
    "data:item-index": "tsx scripts/generate-calculator-item-index.ts",
    "data:monster-index": "tsx scripts/generate-calculator-monster-index.ts",
    "sprite:costume": "node scripts/generate-costume-walker.mjs",
    "sprite:manifest": "node scripts/generate-costume-walker.mjs --refresh-manifest",
    "build": "npm run data:item-index && npm run data:monster-index && next build",
    "build:api": "npm --prefix api run build",
    "render:api:build": "npm install --include=dev && npm --prefix api install --include=dev && npm --prefix api run prisma:generate && npm --prefix api run prisma:deploy && npm --prefix api run build",
    "render:api:migrate": "npm --prefix api run prisma:deploy",
    "render:api:start": "npm --prefix api run start",
    "start": "next start",
    "test": "npm run test:calculator",
    "test:all": "vitest run",
    "test:calculator": "vitest run components/calculator packages/calculator-core/src/calculate-damage-from-dataset.spec.ts packages/calculator-core/src/calculator-equipment-flow.spec.ts packages/calculator-core/src/cast-timing.spec.ts packages/calculator-core/src/skills/skill-formula-registry.spec.ts packages/calculator-core/src/modifiers/rathena-script-parser.spec.ts packages/calculator-core/src/modifiers/rathena-expression.spec.ts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit --pretty false",
    "lint": "eslint",
    "lint:api": "npm --prefix api run lint"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@tanstack/react-query": "^5.101.2",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "yaml": "^2.9.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "gifenc": "^1.0.3",
    "pngjs": "^7.0.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^5",
    "vitest": "^4.1.7"
  }
}
